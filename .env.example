APP_NAME="TRACE-S"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Keamanan Hash & Sesi
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# SESSION_SECURE_COOKIE=true (wajib di produksi HTTPS)

QUEUE_CONNECTION=database
CACHE_STORE=database

# Database (SQLite untuk dev/lokal; gunakan MySQL/PostgreSQL untuk produksi)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=trace_s
# DB_USERNAME=trace_app
# DB_PASSWORD=

# Lokasi Eksternal Registry Trace-ID (di produksi arahkan di luar repositori & web root)
# TRACE_PROVISIONING_PATH=/etc/trace-s/provisioning
# TRACE_REGISTRY_PATH=/etc/trace-s/provisioning/registry
# TRACE_ISSUED_PATH=/var/lib/trace-s/issued

# Batas Keamanan Autentikasi
TRACE_LOGIN_MAX_ATTEMPTS=5
TRACE_LOGIN_DECAY=300
# TRUSTED_PROXIES=127.0.0.1

# Konfigurasi AI Server (Model-Agnostic)
# Driver: ollama | openai_compatible | mock | external
# - Ollama lokal: driver=ollama, base_url=http://127.0.0.1:11434
# - LM Studio lokal (Qwen3-14B): driver=openai_compatible, base_url=http://127.0.0.1:1234
# - Workstation PUSSIBERAD (Qwen3-27B): driver=openai_compatible, base_url=http://<IP-LAN>:1234
AI_DRIVER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_API_KEY=
AI_REQUIRE_LOCAL=true
AI_ALLOW_EXTERNAL=false
AI_MOCK_MODE=ok
AI_TIMEOUT=180
TRACE_CLASSIFICATION_LABEL="TERBATAS // OPERASIONAL PUSSIBERAD"
